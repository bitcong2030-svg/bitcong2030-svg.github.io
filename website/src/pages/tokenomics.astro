---
import BaseLayout from '../layouts/BaseLayout.astro';
import TokenomicsView from '../views/TokenomicsView.astro';
import { getDict } from '../lib/i18n';

const t = getDict('en');
---

<BaseLayout lang="en" prefix="" path="/tokenomics/" title={`${t.tokenomics.title} — BitCong`} description={t.tokenomics.intro} active="tokenomics">
  <TokenomicsView lang="en" prefix="" />
</BaseLayout>
