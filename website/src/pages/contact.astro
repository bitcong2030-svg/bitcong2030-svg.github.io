---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactView from '../views/ContactView.astro';
import { getDict } from '../lib/i18n';

const t = getDict('en');
---

<BaseLayout lang="en" prefix="" path="/contact/" title={`${t.contact.title} — BitCong`} description={t.contact.intro} active="contact">
  <ContactView lang="en" prefix="" />
</BaseLayout>
