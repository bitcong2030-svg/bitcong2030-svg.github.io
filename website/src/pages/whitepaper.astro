---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhitepaperView from '../views/WhitepaperView.astro';
import { getDict } from '../lib/i18n';

const t = getDict('en');
---

<BaseLayout lang="en" prefix="" path="/whitepaper/" title={`${t.whitepaper.title} — BitCong`} description={t.whitepaper.intro} active="whitepaper">
  <WhitepaperView lang="en" prefix="" />
</BaseLayout>
