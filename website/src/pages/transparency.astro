---
import BaseLayout from '../layouts/BaseLayout.astro';
import TransparencyView from '../views/TransparencyView.astro';
import { getDict } from '../lib/i18n';

const t = getDict('en');
---

<BaseLayout lang="en" prefix="" path="/transparency/" title={`${t.transparency.title} — BitCong`} description={t.transparency.intro} active="transparency">
  <TransparencyView lang="en" prefix="" />
</BaseLayout>
