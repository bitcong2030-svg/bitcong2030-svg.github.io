---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhitepaperView from '../../views/WhitepaperView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/whitepaper/" title={`${t.whitepaper.title} — BitCong`} description={t.whitepaper.intro} active="whitepaper">
  <WhitepaperView lang={lang} prefix={prefix} />
</BaseLayout>
