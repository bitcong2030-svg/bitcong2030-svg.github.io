---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TokenomicsView from '../../views/TokenomicsView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/tokenomics/" title={`${t.tokenomics.title} — BitCong`} description={t.tokenomics.intro} active="tokenomics">
  <TokenomicsView lang={lang} prefix={prefix} />
</BaseLayout>
