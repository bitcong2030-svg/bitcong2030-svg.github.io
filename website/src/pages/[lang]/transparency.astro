---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TransparencyView from '../../views/TransparencyView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/transparency/" title={`${t.transparency.title} — BitCong`} description={t.transparency.intro} active="transparency">
  <TransparencyView lang={lang} prefix={prefix} />
</BaseLayout>
