---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactView from '../../views/ContactView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/contact/" title={`${t.contact.title} — BitCong`} description={t.contact.intro} active="contact">
  <ContactView lang={lang} prefix={prefix} />
</BaseLayout>
