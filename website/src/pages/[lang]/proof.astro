---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProofView from '../../views/ProofView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/proof/" title={`${t.proof.title} — BitCong`} description={t.proof.intro} active="proof">
  <ProofView lang={lang} />
</BaseLayout>
