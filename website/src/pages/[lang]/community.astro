---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityView from '../../views/CommunityView.astro';
import { getDict } from '../../lib/i18n';
import { locales, type LocaleCode } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.status === 'ready').map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LocaleCode;
const t = getDict(lang);
const prefix = `/${lang}`;
---

<BaseLayout lang={lang} prefix={prefix} path="/community/" title={`${t.community.title} — BitCong`} description={t.community.intro} active="community">
  <CommunityView lang={lang} prefix={prefix} />
</BaseLayout>
