---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityView from '../views/CommunityView.astro';
import { getDict } from '../lib/i18n';

const t = getDict('en');
---

<BaseLayout lang="en" prefix="" path="/community/" title={`${t.community.title} — BitCong`} description={t.community.intro} active="community">
  <CommunityView lang="en" prefix="" />
</BaseLayout>
