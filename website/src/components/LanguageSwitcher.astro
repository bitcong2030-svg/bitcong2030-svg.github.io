---
import { locales, type LocaleCode } from '../i18n/locales';
import { getDict, url } from '../lib/i18n';

interface Props {
  lang: LocaleCode;
  prefix: string;
  path: string;
  label: string;
}

const { lang, prefix, path, label } = Astro.props;
const t = getDict(lang);
const current = locales.find((l) => l.code === lang) ?? locales[0];

/**
 * 切换语言时保留当前页面路径。
 * 英文有两套入口：根路径（默认主站）与 /en/；因此英文目标要按当前所在的树来选，
 * 不能沿用当前语言前缀，否则在 /zh-cn/ 下点 English 会原地不动。
 */
const target = (code: LocaleCode): string => {
  const segment = code === 'en' ? (prefix === '' ? '' : '/en') : `/${code}`;
  return url(`${segment}${path}`);
};
---

<div class="lang" data-lang-switcher>
  <button class="lang-btn" type="button" aria-expanded="false" aria-label={label}>
    <span class="globe">◎</span>
    <span>{current.short}</span>
    <span class="caret">▾</span>
  </button>
  <div class="lang-menu" role="menu">
    {locales.map((l) => (
      l.status === 'ready' ? (
        <a
          class:list={['lang-item', { current: l.code === lang }]}
          href={target(l.code)}
          role="menuitem"
        >
          <span class="flag">{l.flag}</span>
          <span>{l.label}</span>
        </a>
      ) : (
        <div class="lang-item disabled" aria-disabled="true" role="menuitem">
          <span class="flag">{l.flag}</span>
          <span>{l.label}</span>
          <span class="soon">{t.common.comingSoon}</span>
        </div>
      )
    ))}
  </div>
</div>

<script>
  const root = document.querySelector('[data-lang-switcher]');
  const btn = root?.querySelector('.lang-btn');
  const menu = root?.querySelector('.lang-menu');

  btn?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = menu?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', () => {
    menu?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
