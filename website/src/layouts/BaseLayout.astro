---
import type { LocaleCode } from '../i18n/locales';
import { locales, getLocale } from '../i18n/locales';
import { siteUrl } from '../config/site';
import { canonicalPath } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  lang: LocaleCode;
  prefix: string;
  path: string;
  title: string;
  description: string;
  active?: string;
}

const { lang, prefix, path, title, description, active } = Astro.props;
const locale = getLocale(lang);
const canonical = `${siteUrl}${canonicalPath(lang, path)}`;
const ready = locales.filter((l) => l.status === 'ready');
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0D10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    {ready.map((l) => (
      <link rel="alternate" hreflang={l.htmlLang} href={`${siteUrl}${canonicalPath(l.code, path)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${canonicalPath('en', path)}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BitCong" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body id="top">
    <Header lang={lang} prefix={prefix} path={path} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} prefix={prefix} />

    <a class="to-top" href="#top" aria-label="Back to top" id="toTop">↑</a>
    <script>
      const top = document.getElementById('toTop');
      const toggle = () => {
        if (window.scrollY > 600) top?.classList.add('show');
        else top?.classList.remove('show');
      };
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
    </script>
  </body>
</html>
